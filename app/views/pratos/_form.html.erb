<div class="formulario">  
<%= form_with(model: @prato) do |form| %>
<div>

 <%= form.label :nome%>
 <%= form.text_field :nome%>
</div>

<div>

 <%= form.label :descricao%>
 <%= form.text_field :descricao%>
</div>

<div>

 <%= form.label :preco%>
 <%= form.text_field :preco%>
</div>


 <%= form.submit "Salvar" %>
 <%end%>
</div>